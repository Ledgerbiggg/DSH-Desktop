<ui:FluentWindow x:Class="Dsh.Views.TerminalWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="DeepSeek harness 升级"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterOwner"
                 Background="#1E1E1E" Opacity="0"
                 Height="420" Width="680" MinHeight="260" MinWidth="440"
                 Loaded="OnLoaded" Closing="OnClosing" Closed="OnClosed"
                 PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <Grid.RenderTransform>
            <!-- 入场上滑动画的位移源：挂内容根 Grid 而非窗口本身，
                 FluentWindow 自带 chrome 模板，窗口级 RenderTransform 会在模板应用时抛异常 -->
            <TranslateTransform x:Name="EntryTransform" Y="14" />
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 保留系统式标题栏关闭按钮：非模态弹窗，随手关闭不影响后台升级 -->
        <ui:TitleBar Grid.Row="0" Title="DeepSeek harness 升级" />

        <!-- 终端风输出区：等宽字体，支持鼠标拖选、Ctrl+C / 右键复制 -->
        <RichTextBox x:Name="OutputBox" Grid.Row="1"
                     IsReadOnly="True" IsReadOnlyCaretVisible="False"
                     Background="Transparent" BorderThickness="0"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     TextChanged="OutputBox_TextChanged">
            <RichTextBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Command="ApplicationCommands.Copy" Header="复制" />
                </ContextMenu>
            </RichTextBox.ContextMenu>
            <RichTextBox.Document>
                <FlowDocument Foreground="#CCCCCC" PagePadding="16,8"
                              FontFamily="SF Mono, Cascadia Mono, Consolas" FontSize="13"
                              LineHeight="17" LineStackingStrategy="BlockLineHeight" />
            </RichTextBox.Document>
        </RichTextBox>
    </Grid>
</ui:FluentWindow>
