<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Dsh</RootNamespace>
    <AssemblyName>Dsh</AssemblyName>
    <Version>0.2.7</Version>
    <!-- 应用图标：嵌入 exe -->
    <ApplicationIcon>Assets\deepseek-dark_48x48.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="Prism.Unity" Version="8.1.97" />
    <PackageReference Include="WPF-UI" Version="4.0.0" />
  </ItemGroup>

  <!-- 应用图标与资源图片：打包进 exe -->
  <ItemGroup>
    <Resource Include="Assets\**\*" />
  </ItemGroup>

  <!-- 托盘 .ico 的 Debug 期磁盘副本：仅作 AppIcon 最后回退。
       单文件发布时该副本会并入 bundle（安装目录无 Assets），
       运行时统一走 exe 内嵌 Win32 图标提取，见 Util/AppIcon.cs -->
  <ItemGroup>
    <Content Include="Assets\deepseek-dark_48x48.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- 版本说明文件：统一放仓库根目录，经 Link 以 version.json 名义拷入输出目录，运行时读取路径不变 -->
  <ItemGroup>
    <Content Include="..\version.json" Link="version.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
